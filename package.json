{
  "name": "rezo",
  "version": "0.1.0",
  "private": true,
  "description": "Rezo — National Digital Trade Platform for Haiti (beta). Monorepo root.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev:api": "npm run start:dev --workspace @rezo/api",
    "dev:web": "npm run dev --workspace @rezo/web",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @rezo/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @rezo/api"
  },
  "engines": {
    "node": ">=20"
  }
}
