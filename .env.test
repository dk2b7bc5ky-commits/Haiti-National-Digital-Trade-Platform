# Environment for the e2e test suite. Dev/placeholder values only — no real secrets.
# Uses a SEPARATE database (rezo_test) so tests never touch dev data.
DATABASE_URL=postgresql://rezo:rezo_dev_password@localhost:5432/rezo_test?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rezo_minio_access
S3_SECRET_KEY=rezo_minio_secret
S3_BUCKET=rezo-documents-test
JWT_SECRET=test_only_jwt_secret
JWT_EXPIRES_IN=1d
API_PORT=4100
MARKET_CODE=HT
