# ---------------------------------------------------------------------------
# Rezo — environment variables (Step 1 scaffold)
# Copy this file to `.env` and adjust as needed. NEVER commit real secrets.
# The same file is read by docker-compose, the NestJS API, and the Next.js web app.
# ---------------------------------------------------------------------------

# --- PostgreSQL (system of record) ---
POSTGRES_USER=rezo
POSTGRES_PASSWORD=rezo_dev_password
POSTGRES_DB=rezo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection string (used by the API). Host is `localhost` from the host
# machine; inside Docker networking it would be the service name `postgres`.
DATABASE_URL=postgresql://rezo:rezo_dev_password@localhost:5432/rezo?schema=public

# --- Redis (queue / async jobs) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rezo_minio_access
S3_SECRET_KEY=rezo_minio_secret
S3_BUCKET=rezo-documents
# MinIO console (web UI) port
MINIO_CONSOLE_PORT=9001

# --- Auth (JWT) ---
# Placeholder only — generate a strong secret for any real deployment.
JWT_SECRET=change_me_dev_only_jwt_secret
JWT_EXPIRES_IN=1d

# --- API service ---
API_PORT=4000
# Base path is fixed at /api/v1 per the spec; this is the full origin the web app calls.
API_BASE_URL=http://localhost:4000

# --- Web service (Next.js) ---
WEB_PORT=3000
# Public URL the browser uses to reach the API (must be reachable from the client).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Email agent (arrival-notice intake) — see docs/CONNECT_EMAIL.md ---
# Reader: with no key the app falls back to a deterministic mock extractor.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
ANTHROPIC_MODEL=
# Mailbox App Password. PLACEHOLDER ONLY — never commit a real credential.
# With no value the agent uses a built-in demo inbox instead of a real mailbox.
MAIL_INTAKE_PASSWORD=
# "true" lets the agent poll the mailbox every 10 minutes. Off by default.
MAIL_INTAKE_ENABLED=false
# Max emails read per check, and how far back to look on a first-ever sync.
MAIL_INTAKE_BATCH=25
MAIL_INTAKE_FIRST_SYNC_DAYS=14
# Messages read per "catch up on older mail" batch (the UI repeats until done).
MAIL_INTAKE_BACKFILL_BATCH=8
