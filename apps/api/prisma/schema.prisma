// Rezo — Prisma schema
//
// Step 2: Identity, Tenancy & RBAC (spec §7, §1.1).
//
// NON-NEGOTIABLE RULE #2 (spec §9 / §11): no model in this schema may ever
// introduce a `balance`, `wallet`, `credit`, or `float` field. Rezo never
// holds customer funds. This is enforced by an automated test.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// The kind of party an Organization (tenant) represents.
enum OrgType {
  SHIPPING_LINE
  IMPORTER
  BROKER
  TRUCKER
  TERMINAL
  CUSTOMS
  BANK
  GOV
  REZO
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

/// A user's role. Drives the RBAC permission matrix (see src/rbac).
enum Role {
  SHIPPING_LINE
  IMPORTER
  BROKER
  TRUCKER
  TERMINAL
  CUSTOMS
  BANK
  GOV_VIEWER
  REZO_OPS
  REZO_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A tenant. Every user and (later) every business record belongs to one org.
model Organization {
  id        String    @id @default(uuid())
  type      OrgType
  legalName String    @map("legal_name")
  country   String    @default("HT")
  kycStatus KycStatus @default(PENDING) @map("kyc_status")
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users   User[]
  apiKeys ApiKey[]

  @@map("organizations")
}

model User {
  id           String     @id @default(uuid())
  orgId        String     @map("org_id")
  name         String
  email        String     @unique
  role         Role
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("users")
}

/// API keys let API-connected orgs (e.g. large brokers, lines) exchange a key
/// for a short-lived JWT. Only the hash is stored; the plaintext is shown once.
model ApiKey {
  id         String       @id @default(uuid())
  orgId      String       @map("org_id")
  name       String
  prefix     String       @unique // human-visible identifier, e.g. "rzk_ab12"
  keyHash    String       @unique @map("key_hash")
  scopes     String[]     @default([])
  status     ApiKeyStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  lastUsedAt DateTime?    @map("last_used_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("api_keys")
}

/// Append-only audit trail (spec §11). Rows are only ever inserted, never
/// updated or deleted. `before`/`after` capture the change for money and
/// state mutations across the platform.
model AuditLog {
  id         String   @id @default(uuid())
  actorUserId String? @map("actor_user_id")
  actorOrgId String?  @map("actor_org_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorOrgId])
  @@map("audit_logs")
}
